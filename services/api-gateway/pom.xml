<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.wrsensor</groupId>
    <artifactId>api-gateway</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>api-gateway</name>
    <description>api-gateway — FEAT-0007 punto de entrada unico, rate limiting y correlacion</description>

    <properties>
        <java.version>25</java.version>
    </properties>

    <dependencies>
        <!-- WebFlux unicamente: WebClient (proxy), RouterFunction (rutas),
             ReactorNettyWebSocketClient + SimpleUrlHandlerMapping (puente WS).
             FEAT-0007 BR-013: cero dependencias nuevas. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          FEAT-0009 BR-010: empaquetado del SPA en los estáticos del gateway.

          Es un profile **opt-in** a propósito: el build del SPA lo hace npm (necesita red), así que
          el ciclo `mvn -o test` del backend queda intacto. Se activa sólo cuando se quiere el SPA
          dentro del jar:

            cd web && npm ci && npm run build
            mvn -o -f services/api-gateway/pom.xml package -Pcon-spa

          No invoca npm desde Maven (eso rompería la propiedad offline); sólo copia `web/dist`, que
          ya tiene que existir. En Docker el empaquetado lo hace el stage de Node del Dockerfile, así
          que este profile es para correr el gateway localmente sin contenedores.
        -->
        <profile>
            <id>con-spa</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>copiar-spa</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.basedir}/../../web/dist</directory>
                                            <filtering>false</filtering>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
