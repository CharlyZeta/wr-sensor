# Variables del SPA (FEAT-0009). Todas se **inlinean en el build**: nunca poner secretos acá.
# Copiar a `.env.local` para desarrollo (ese archivo está en .gitignore).

# Base de la API. Vacío (default) = mismo origen: en producción el gateway sirve el SPA y en
# desarrollo el proxy de Vite manda /api y /ws al gateway, así que no hace falta cambiarla.
VITE_API_BASE=

# Período de refresco del resumen del mapa (ms). Debe quedar muy por debajo del cupo de la clase
# `lectura` del gateway (120/min): 30000 = 2 requests/min por pestaña.
VITE_RESUMEN_REFRESCO_MS=30000

# Plantilla de tiles del mapa (Leaflet). Si se cambia de proveedor hay que ajustar también
# `gateway.seguridad.content-security-policy` (img-src) del lado del gateway.
VITE_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILES_ATRIBUCION=© OpenStreetMap

# Locale para formateo de números y fechas.
VITE_LOCALE=es-AR

# ---- detalle en vivo (FEAT-0014) ----
# Ventana de la serie, tope de puntos que se piden al histórico y refresco de respaldo cuando el WS
# está pausado. El tope protege el cupo del gateway (clase `lectura`: 120/min).
VITE_SERIE_HORAS=24
VITE_SERIE_MAX_PUNTOS=2000
VITE_SERIE_REFRESCO_MS=60000
VITE_TABLA_FILAS=25
# Un dato más viejo que esto se marca como vencido.
VITE_DATO_VENCIDO_MS=120000
# Reconexión del WebSocket: backoff exponencial con jitter y tope de intentos.
VITE_WS_BACKOFF_BASE_MS=1000
VITE_WS_BACKOFF_FACTOR=2
VITE_WS_BACKOFF_TOPE_MS=30000
VITE_WS_MAX_INTENTOS=6
# ---- alertas en vivo (FEAT-0015) ----
# Tope de entradas del feed en memoria y agrupación de ráfagas: con varias alertas en pocos segundos
# se dispara UNA recarga del resumen (evita agotar el cupo de la clase `lectura`).
VITE_ALERTAS_MAX=200
VITE_ALERTAS_DEBOUNCE_MS=2000
