# Copiar a .env para personalizar secretos/puertos.
# Nada de esto vale para producción: son valores de desarrollo local.
#
# Secreto de firma JWT (lo comparten sensor-registry y api-gateway).
AUTH_JWT_SECRET=wrsensor-dev-secret-2026-no-usar-en-prod

# Credenciales del usuario de servicio VIEWER que siembra DevUserSeeder al arrancar
# sensor-registry. ingestion-service y query-api las usan para leer la config de los
# sensores. Default en código y en `docker-compose.yml`: `localdev` (FEAT-0019).
REGISTRY_AUTH_EMAIL=viewer@wrsensor.local
REGISTRY_AUTH_PASSWORD=localdev

# query-api mantiene su propia variable para el mismo usuario de servicio.
QUERY_REGISTRY_EMAIL=viewer@wrsensor.local
QUERY_REGISTRY_PASS=localdev
